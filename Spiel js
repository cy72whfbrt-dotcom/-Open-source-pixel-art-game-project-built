// Prüft ob eine Feld-Koordinate innerhalb eines zentrierten Quadrats liegt

function inBereich(x,y,groesse){

    let start =
    mitte - Math.floor(groesse/2);

    return (
        x>=start && x<start+groesse &&
        y>=start && y<start+groesse
    );

}

// Insel aktualisieren

function aktualisierePlattform(){

    let felder=
    document.querySelectorAll(".feld");

    felder.forEach(feld=>{

        feld.classList.remove("gruen");

    });

    let gruenGroesse =
    Math.min(plattformGroesse,GRUEN_MAX);

    let gStartX =
    mitte -
    Math.floor(gruenGroesse/2);

    let gStartY =
    mitte -
    Math.floor(gruenGroesse/2);

    for(let y=0;y<gruenGroesse;y++){

        for(let x=0;x<gruenGroesse;x++){

            let gx=gStartX+x;

            let gy=gStartY+y;

            let feld =
            felder[
                gy*GROESSE+gx
            ];

            if(feld){

                feld.classList.add("gruen");

            }

        }

    }

    // Grüne Oberseite exakt über der Kachel-Fläche

    inselOberseite.style.left=
    (gStartX*FELD)+"px";

    inselOberseite.style.top=
    (gStartY*FELD)+"px";

    inselOberseite.style.width=
    (gruenGroesse*FELD)+"px";

    inselOberseite.style.height=
    (gruenGroesse*FELD)+"px";

    // Braune Unterseite: gleiche Breite, nur unten leicht überstehend

    inselUnterseite.style.left=
    (gStartX*FELD)+"px";

    inselUnterseite.style.top=
    (gStartY*FELD+10)+"px";

    inselUnterseite.style.width=
