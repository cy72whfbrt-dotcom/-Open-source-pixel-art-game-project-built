function zeigeOverlay(id){

    if(offenesOverlay && offenesOverlay!==id){

        $(offenesOverlay).classList.remove("offen");

    }

    offenesOverlay=id;

    $(id).classList.add("offen");

}

function schliesse(id){

    $(id).classList.remove("offen");

    if(offenesOverlay===id)offenesOverlay=null;

    speichern();

}

