function schalte(id,farbe,anAn){

    $(id).className="ausrKaufBtn "+farbe+(anAn?"":" aus");

}

function oeffneTruhe(seltenheit,element){

    const item=baueItem(

        zufallsSlot(),
        seltenheit,
        1+Math.floor(Math.random()*10)

    );

    inventar.push(item);

    if(typeof questFortschritt==="function"){

        questFortschritt("truhen",1);

    }

    flugAnimation(item,element);

    zeichneShop();

    speichern();

}

function oeffnePetTruhe(element){

    const seltenheit=ziehe(PET_RANG);

    const art=PET_ARTEN[seltenheit];

    const pet={

        id:idZaehler++,
        seltenheit:seltenheit,
        name:art.name,
        datei:art.datei,
        stufe:1

    };

    meinePets.push(pet);

    if(typeof questFortschritt==="function"){

        questFortschritt("truhen",1);

    }

    petFlugAnimation(pet,element);

    zeichnePetSammlung();

    // Wie beim Ausruestungs-Kauf: Anzeige im Shop auffrischen,
    // sonst stehen dort noch die alten Juwelen

    zeichneShop();

    speichern();

}

function petFlugAnimation(pet,element){

    const el=document.createElement("div");

    el.className="ausrBelohnung";

    el.style.background=SELTENHEIT[pet.seltenheit].farbe;

    el.innerHTML=slimeBild(pet.datei,52);

    const box=element.getBoundingClientRect();

    el.style.left=(box.left+box.width/2)+"px";

    el.style.top=(box.top+box.height/2)+"px";

    document.body.appendChild(el);

    requestAnimationFrame(()=>el.classList.add("aktiv"));

    setTimeout(()=>el.remove(),1600);

}

function flugAnimation(item,element){

    const el=document.createElement("div");

    el.className="ausrBelohnung";

    el.style.background=SELTENHEIT[item.seltenheit].farbe;

    el.innerHTML=teilBild(item.slot,52);

    const box=element.getBoundingClientRect();

    el.style.left=(box.left+box.width/2)+"px";

    el.style.top=(box.top+box.height/2)+"px";

    document.body.appendChild(el);

    requestAnimationFrame(()=>el.classList.add("aktiv"));

    setTimeout(()=>el.remove(),1600);

}

