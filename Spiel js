// ============================================
// Aufgaben-System
// ============================================

function aktuellerWertFuer(typ){

    if(typ==="lager")return lagerLevel;

    // Normale Beeren: zähle was der Spieler gesammelt hat
    if(typ in gesammelteBeeren) return gesammelteBeeren[typ];

    return 0;

}

function klonAufgabe(vorlage){

    return {

        ...vorlage,

        anforderungen:
        vorlage.anforderungen.map(a=>({

            typ:a.typ,

            ziel:a.ziel,

            fortschritt:Math.min(
                aktuellerWertFuer(a.typ),
                a.ziel
            )

        })),

        abgeschlossen:false

    };

}

function starteAufgaben(){

    
    
    if(!aufgabenListe[level]){
        console.error("❌ FEHLER: Keine Aufgaben für Level", level);
        return;
    }

    aktiveAufgaben=[];

    let offene =
    aufgabenListe[level]
    .filter(
        a=>!erledigteAufgaben.includes(a.id) && !a.isLagerUpgrade
    );
    

    while(
        aktiveAufgaben.length<2 &&
        offene.length>0
    ){

        let neu =
        offene.shift();
        

        aktiveAufgaben.push(
            klonAufgabe(neu)
        );

    }

    zeigeAufgaben();

}

