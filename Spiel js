// KNOEPFE
// ============================================================

function verdrahte(){

    document.querySelectorAll(".ausrX").forEach(b=>{

        b.onclick=()=>schliesse(b.dataset.zu);

    });

    document.querySelectorAll(".ausrOverlay").forEach(o=>{

        o.onclick=e=>{ if(e.target===o)schliesse(o.id); };

    });

    let shopSymbol=$("ausrShopIcon");

    shopSymbol.innerHTML=
    bild(BILD.shop,34)+'<span class="beschriftung">SHOP</span>';

    shopSymbol.onclick=()=>{ zeichneShop(); zeigeOverlay("ausrShop"); };

    // Pfoten-Feld unter dem Spieler oeffnet das Haustier-Fenster

    let petSlot=$("ausrPetSlot");

    if(petSlot){

        petSlot.onclick=()=>{ zeichnePets(); zeichnePetSammlung(); zeigeOverlay("ausrPets"); };

    }

    $("ausrSortBtn").onclick=()=>{ sortLevel=!sortLevel; zeichneInventar(); };

    $("ausrKombiBtn").onclick=kombiniere;

    $("ausrBtnMuenzen").onclick=function(){

        if(holeMuenzen()<PREIS_MUENZEN)return;

        zahleMuenzen(PREIS_MUENZEN);

        oeffneTruhe(ziehe(["grau","gruen"]),this);

    };

    $("ausrBtnSchluessel").onclick=function(){

        if(schluessel<1)return;

        schluessel--;

        oeffneTruhe(ziehe(["grau","gruen"]),this);

    };

    $("ausrBtnPremium").onclick=function(){

        if(holeJuwelen()<PREIS_JUWELEN)return;

        zahleJuwelen(PREIS_JUWELEN);

        pity++;

        let seltenheit;

        if(pity>=PITY_ZIEL){

            seltenheit="lila";

            pity=0;

        }else{

            seltenheit=ziehe(["gruen","blau","lila"]);

            if(seltenheit==="lila")pity=0;

        }

        oeffneTruhe(seltenheit,this);

    };

    $("ausrBtnPet").onclick=function(){

        if(holeJuwelen()<PREIS_PET_JUWELEN)return;

        zahleJuwelen(PREIS_PET_JUWELEN);

        oeffnePetTruhe(this);

    };

    $("ausrPDAnlegen").onclick=()=>{

        if(!gewaehltesPet)return;

        angelegtesPetId=
        angelegtesPetId===gewaehltesPet.id?null:gewaehltesPet.id;

        zeichnePetDetail();

        zeichnePetSammlung();

        zeichnePetSlot();

        speichern();

    };

    $("ausrPDUpgrade").onclick=()=>{

        if(!gewaehltesPet || gewaehltesPet.stufe>=PET_MAX_STUFE)return;

        const kosten=petUpgradeKosten(gewaehltesPet);

        if(holeMuenzen()<kosten)return;

        zahleMuenzen(kosten);

        gewaehltesPet.stufe++;

        zeichnePetDetail();

        zeichnePetSammlung();

        zeichnePetSlot();

        speichern();

    };

    $("ausrPDMax").onclick=()=>{

        if(!gewaehltesPet)return;

        while(gewaehltesPet.stufe<PET_MAX_STUFE){

            const kosten=petUpgradeKosten(gewaehltesPet);

            if(holeMuenzen()<kosten)break;

            zahleMuenzen(kosten);

            gewaehltesPet.stufe++;

        }

        zeichnePetDetail();

        zeichnePetSammlung();

        zeichnePetSlot();

        speichern();

    };

    $("ausrBtnAusruesten").onclick=()=>{

        if(!gewaehltesItem)return;

        angelegt[gewaehltesItem.slot]=
        istAngelegt(gewaehltesItem)?null:gewaehltesItem;

        zeichneHub();

        zeichneDetail();

        speichern();

    };

    $("ausrBtnUpgrade").onclick=()=>{

        if(!gewaehltesItem || gewaehltesItem.stufe>=MAX_STUFE)return;

        const kosten=upgradeKosten(gewaehltesItem);

        if(holeMuenzen()<kosten)return;

        zahleMuenzen(kosten);

        gewaehltesItem.stufe++;

        if(typeof questFortschritt==="function"){

            questFortschritt("ausbau",1);

        }

        neuBerechnen(gewaehltesItem);

        zeichneHub();

        zeichneDetail();

        speichern();

    };

    $("ausrBtnMax").onclick=()=>{

        if(!gewaehltesItem)return;

        while(gewaehltesItem.stufe<MAX_STUFE){

            const kosten=upgradeKosten(gewaehltesItem);

            if(holeMuenzen()<kosten)break;

            zahleMuenzen(kosten);

            gewaehltesItem.stufe++;

        }

        neuBerechnen(gewaehltesItem);

        zeichneHub();

        zeichneDetail();

        speichern();

    };

    // Axt-Knopf in der Hotbar oeffnet ab jetzt dieses Fenster.
    // Das alte Ausruestungs-Panel aus spiel.js bleibt unberuehrt,
    // wird aber nicht mehr geoeffnet.

    // Das alte Panel ist aus spiel.js entfernt, also haengt am
    // Axt-Knopf kein zweiter Listener mehr - direkt anhaengen reicht.

    let axtKnopf=document.getElementById("ausruestung");

    if(axtKnopf){

        axtKnopf.addEventListener("click",()=>{

            zeichneHub();

            zeigeOverlay("ausrHub");

        });

    }

}

