        fuss.innerHTML=bestesUpgradeHtml();

    }

    document.querySelectorAll("#aufwertenPanel [data-upgrade]").forEach(btn=>{

        btn.addEventListener("click",()=>{

            kaufeErtrag(btn.dataset.upgrade);

        });

    });

}

