function petZielFinden(pet){

    let naechste=null;

    let minEntfernung=
    petRadius(pet.level);

    // Radius wird vom Lager aus gemessen, nicht vom Spieler

    let lagerMitteX=mitte*FELD+20;

    let lagerMitteY=mitte*FELD+20;

    buesche.forEach(o=>{

        if(!o.aktiv || o.zielVon)return;

        let dx=lagerMitteX-(o.x+20);

        let dy=lagerMitteY-(o.y+20);

        let entfernung=
        Math.sqrt(dx*dx+dy*dy);

        if(entfernung<minEntfernung){

            minEntfernung=entfernung;

            naechste=o;

        }

    });

    return naechste;

}

function aktualisierePets(deltaFaktor){

    pets.forEach(pet=>{

        if(pet.ziel && !pet.ziel.aktiv){

            pet.ziel=null;

        }

        if(!pet.ziel){

            pet.ziel=petZielFinden(pet);

            if(pet.ziel){

                pet.ziel.zielVon=pet;

            }

        }

        let petTempo=
        aktuellesTempo()*0.7;

        if(pet.ziel){

            let zx=pet.ziel.x+20;

            let zy=pet.ziel.y+20;

            let dx=zx-pet.x;

            let dy=zy-pet.y;

            let distanz=
            Math.sqrt(dx*dx+dy*dy);

            if(distanz<26){

                petErnten(pet);

            }else{

                pet.x+=
                (dx/distanz)*petTempo*deltaFaktor;

                pet.y+=
                (dy/distanz)*petTempo*deltaFaktor;

            }

        }else{

            let lagerMitteX=mitte*FELD+20;

            let lagerMitteY=mitte*FELD+20;

            let dx=lagerMitteX-pet.x;

            let dy=lagerMitteY-pet.y;

            let distanz=
            Math.sqrt(dx*dx+dy*dy);

            if(distanz>36){

                pet.x+=
                (dx/distanz)*petTempo*deltaFaktor;

                pet.y+=
                (dy/distanz)*petTempo*deltaFaktor;

            }

        }

        pet.element.style.left=
        pet.x+"px";

        pet.element.style.top=
        pet.y+"px";

    });

}

function petErnten(pet){

    // Ernte-Logik entfernt (war busch-spezifisch)

    pet.ziel=null;

}

