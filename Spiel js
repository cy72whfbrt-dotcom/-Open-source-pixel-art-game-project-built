// ---- Brueckenfunktionen zu spiel.js ------------------------

function holeMuenzen(){ return typeof coins==="number"?coins:0; }
function holeJuwelen(){ return typeof juwelen==="number"?juwelen:0; }

function zahleMuenzen(betrag){

    if(typeof coins!=="number")return;

    coins-=betrag;

    if(typeof aktualisiereAnzeige==="function")aktualisiereAnzeige();

}

function zahleJuwelen(betrag){

    if(typeof juwelen!=="number")return;

    juwelen-=betrag;

    if(typeof aktualisiereAnzeige==="function")aktualisiereAnzeige();

}

function schenkeJuwelen(betrag){

    if(typeof juwelen!=="number")return;

    juwelen+=betrag;

    if(typeof aktualisiereAnzeige==="function")aktualisiereAnzeige();

}

function holeLevel(){ return typeof level==="number"?level:1; }

// ============================================================
// SPEICHERN
// ============================================================

function speichern(){

    try{

        localStorage.setItem(SPEICHER,JSON.stringify({

            schluessel:schluessel,
            pity:pity,
            idZaehler:idZaehler,
            inventar:inventar,
            meinePets:meinePets,
            angelegtesPetId:angelegtesPetId,
            angelegtIds:Object.fromEntries(
                Object.keys(angelegt).map(k=>[k,angelegt[k]?angelegt[k].id:null])
            )

        }));

    }catch(e){}

}

function laden(){

    try{

        let roh=localStorage.getItem(SPEICHER);

        if(!roh)return;

        let d=JSON.parse(roh);

        if(typeof d.schluessel==="number")schluessel=d.schluessel;

        if(typeof d.pity==="number")pity=d.pity;

        if(typeof d.idZaehler==="number")idZaehler=d.idZaehler;

        if(Array.isArray(d.inventar))inventar=d.inventar;

        if(Array.isArray(d.meinePets))meinePets=d.meinePets;

        if(typeof d.angelegtesPetId==="number")angelegtesPetId=d.angelegtesPetId;

        if(d.angelegtIds){

            Object.keys(angelegt).forEach(slot=>{

                let id=d.angelegtIds[slot];

                angelegt[slot]=id?inventar.find(i=>i.id===id)||null:null;

            });

        }

    }catch(e){}

}

// ============================================================
// ITEMS
// ============================================================

function baueItem(slot,seltenheit,stufe){

    const t=TEILE[slot];

    return {

        id:idZaehler++,
        slot:slot,
        seltenheit:seltenheit,
        stufe:stufe,
        buff:t.buff,
        staerke:Math.round((t.basis+t.stufig*(stufe-1))*SELTENHEIT[seltenheit].faktor*10)/10

    };

}

function neuBerechnen(item){

    const t=TEILE[item.slot];

    item.staerke=Math.round(
        (t.basis+t.stufig*(item.stufe-1))*SELTENHEIT[item.seltenheit].faktor*10
    )/10;

}

function buffText(buff,menge){

    const b=BUFFS[buff];

    return b.name+" +"+menge.toFixed(b.komma)+b.einheit;

}

function ziehe(auswahl){

    const summe=auswahl.reduce((s,k)=>s+SELTENHEIT[k].chance,0);

    let wurf=Math.random()*summe;

    for(const k of auswahl){

        wurf-=SELTENHEIT[k].chance;

        if(wurf<=0)return k;

    }

    return auswahl[0];

}

function zufallsSlot(){

    const alle=Object.keys(TEILE);

    return alle[Math.floor(Math.random()*alle.length)];

}

function istAngelegt(item){

    return angelegt[item.slot] && angelegt[item.slot].id===item.id;

}

function upgradeKosten(item){

    return Math.round(60*Math.pow(1.6,item.stufe)*SELTENHEIT[item.seltenheit].faktor);

}

// ============================================================
// BUFF-SUMMEN - koennen spaeter im Spiel ausgelesen werden
// ============================================================

function buffSummen(){

    const summe={};

    Object.keys(BUFFS).forEach(k=>summe[k]=0);

    Object.values(angelegt).forEach(i=>{

        if(i)summe[i.buff]+=i.staerke;

    });

    return summe;

}

