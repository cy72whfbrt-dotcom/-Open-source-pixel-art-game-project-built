function zeigeSkillBlase(){

    if(!charakterListeHTML)return;

    let alteBlase=charakterListeHTML.querySelector(".skillBlase");

    if(alteBlase)alteBlase.remove();

    if(!offeneBlase)return;

    let knoten=charakterListeHTML.querySelector('[data-knoten="'+offeneBlase+'"]');

    if(!knoten)return;

    let typ=knoten.dataset.typ;

    let gruppe=Number(knoten.dataset.gruppe);

    let art=SKILL_ARTEN[typ];

    let gekauft=skillKnotenGekauft(typ,gruppe);

    let offen=skillGruppeOffen(gruppe);

    let kosten=skillKnotenKosten(gruppe);

    let wert="+"+art.schritt.toString().replace(".",",")+art.einheit;

