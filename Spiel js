.ausrDBtn.b2{background:linear-gradient(180deg,#7ad35c,#43a028)}
.ausrDBtn.b3{background:linear-gradient(180deg,#ffd24a,#e0940d)}
.ausrDBtn.aus{background:linear-gradient(180deg,#b4b4b4,#828282);opacity:.75}

.ausrBelohnung{position:fixed;width:80px;height:80px;border-radius:16px;border:4px solid #fff;
display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:900;
box-shadow:0 6px 16px rgba(0,0,0,.55)}
@keyframes ausrFliegen{
0%{opacity:0;transform:translate(-50%,-50%) scale(.3)}
20%{opacity:1;transform:translate(-50%,-165%) scale(1.15)}
80%{opacity:1;transform:translate(-50%,-165%) scale(1.15)}
100%{opacity:0;transform:translate(-50%,-205%) scale(.6)}}
.ausrBelohnung.aktiv{animation:ausrFliegen 1.5s ease-out forwards}

