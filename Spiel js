// ============================================================

let letztesLevel=holeLevel();

setInterval(()=>{

    let jetzt=holeLevel();

    if(jetzt>letztesLevel){

        let stufen=jetzt-letztesLevel;

        schluessel+=1*stufen;

        schenkeJuwelen(25*stufen);

        letztesLevel=jetzt;

        speichern();

        if(offenesOverlay==="ausrShop")zeichneShop();

    }else if(jetzt<letztesLevel){

        letztesLevel=jetzt;

    }

},1000);

