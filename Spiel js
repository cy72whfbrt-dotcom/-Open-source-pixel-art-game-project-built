// ============================================
// Haustier-Helfer
//
// Wohnt am Lager. Er sucht sich eine Pflanze aus, die im
// Umkreis um das LAGER steht, laeuft hin, erntet sie und
// sammelt die Fruechte gleich mit ein. Danach macht er kurz
// Pause und geht zurueck, wenn nichts mehr in Reichweite ist.
// ============================================

const PET_GROESSE=22;

const PET_TEMPO=1.9;

let petHelferElement=null;

let petHelferKennung="";

let petX=null;

let petY=null;

let petZiel=null;

let petPause=0;

function holePetInfo(){

    if(typeof window.Ausruestung==="undefined")return null;

    if(typeof window.Ausruestung.aktivesPet!=="function")return null;

    return window.Ausruestung.aktivesPet();

}

function lagerMitteX(){ return mitte*FELD+20; }

function lagerMitteY(){ return mitte*FELD+20; }

function zeigePetHelfer(info){

    if(!info){

        if(petHelferElement){

            petHelferElement.remove();

            petHelferElement=null;

            petHelferKennung="";

        }

        petX=null;

        petY=null;

        petZiel=null;

        petPause=0;

        return;

    }

    if(!petHelferElement){

        petHelferElement=document.createElement("div");

        petHelferElement.className="petHelfer";

        karte.appendChild(petHelferElement);

    }

    let kennung=info.seltenheit+"-"+info.stufe;

    if(kennung!==petHelferKennung){

        petHelferElement.innerHTML=info.bildHtml;

        petHelferKennung=kennung;

    }

    if(petX===null){

        petX=lagerMitteX();

        petY=lagerMitteY()+26;

    }

    petHelferElement.style.left=(petX-PET_GROESSE/2)+"px";

    petHelferElement.style.top=(petY-PET_GROESSE/2)+"px";

}

// Naechste Pflanze, die im Umkreis um das Lager steht

function petSuchtZiel(info){

    let reichweite=info.radiusFelder*FELD;

    let beste=null;

    let besteEntfernung=Infinity;

    for(let i=0;i<pflanzen.length;i++){

        let p=pflanzen[i];

        if(!p.aktiv)continue;

        // Umkreis wird vom Lager aus gemessen

        let lx=lagerMitteX()-(p.x+20);

        let ly=lagerMitteY()-(p.y+20);

        if(Math.sqrt(lx*lx+ly*ly)>reichweite)continue;

        // Von mehreren nimmt er die, die ihm am naechsten ist

        let dx=petX-(p.x+20);

        let dy=petY-(p.y+20);

        let entfernung=Math.sqrt(dx*dx+dy*dy);

        if(entfernung<besteEntfernung){

            besteEntfernung=entfernung;

            beste=p;

        }

    }

    return beste;

}

function petBewegtSich(zielX,zielY,deltaFaktor){

    let dx=zielX-petX;

    let dy=zielY-petY;

    let entfernung=Math.sqrt(dx*dx+dy*dy);

    if(entfernung<2)return 0;

    let schritt=Math.min(entfernung,PET_TEMPO*deltaFaktor);

    petX+=(dx/entfernung)*schritt;

    petY+=(dy/entfernung)*schritt;

    return entfernung-schritt;

}

function petErntet(pflanze,info){

    pflanze.aktiv=false;

    pflanze.element.classList.add("destroyed");

    spawnFallingLeaves(pflanze.x,pflanze.y);

    // Ernte direkt gutschreiben, statt Beeren liegen zu lassen

    let menge=6+Math.floor(Math.random()*3);

    let ertrag=1;

    if(pflanze.art && typeof ertragStufe!=="undefined" && ertragStufe[pflanze.art]){

        ertrag=ertragStufe[pflanze.art];

    }

    ertrag=ertrag*ausruestungsErtragMultiplikator()*(1+info.ertragBonus);

    let gutschrift=Math.max(1,Math.round(menge*ertrag));

    beeren+=gutschrift;

    if(pflanze.art){

        if(!gesammelteBeeren.hasOwnProperty(pflanze.art)){

            gesammelteBeeren[pflanze.art]=0;

        }

        gesammelteBeeren[pflanze.art]+=gutschrift;

        aktualisiereAufgabenFortschritt(pflanze.art,gesammelteBeeren[pflanze.art]);

        if(typeof questFortschritt==="function"){

            questFortschritt("petbeeren",gutschrift);

            questFortschritt("pflanzen",1);

        }

    }

    aktualisiereAufgabenAnzeige();

    pruefeAufgabenDebounced();

    if(beerenCountText){

        beerenCountText.innerHTML=beeren;

    }

    let element=pflanze.element;

    setTimeout(()=>{

        element.remove();

        let index=pflanzen.indexOf(pflanze);

        if(index>-1)pflanzen.splice(index,1);

        pflanzeErstellen();

    },400);

}

function aktualisierePetHelfer(deltaMs,deltaFaktor){

    let info=holePetInfo();

    zeigePetHelfer(info);

    if(!info)return;

    // Pause nach dem Ernten

    if(petPause>0){

        petPause-=deltaMs;

        // In der Pause schlendert er Richtung Lager zurueck

        petBewegtSich(lagerMitteX(),lagerMitteY()+26,deltaFaktor*0.5);

        return;

    }

    // Ziel pruefen und notfalls neu suchen

    if(petZiel && !petZiel.aktiv)petZiel=null;

    if(!petZiel)petZiel=petSuchtZiel(info);

    if(!petZiel){

        // Nichts in Reichweite - zurueck zum Lager

        petBewegtSich(lagerMitteX(),lagerMitteY()+26,deltaFaktor);

        return;

    }

    let rest=petBewegtSich(petZiel.x+20,petZiel.y+20,deltaFaktor);

    if(rest<=22){

        petErntet(petZiel,info);

        petZiel=null;

        petPause=info.intervall;

    }

}

// Spiel Update

let letzterZeitstempel=null;

function update(zeitstempel){

    if(letzterZeitstempel===null){

        letzterZeitstempel=zeitstempel;

    }

    let deltaMs =
    zeitstempel-letzterZeitstempel;

    letzterZeitstempel=zeitstempel;

    if(deltaMs>100)deltaMs=100;

    let deltaFaktor =
    deltaMs/(1000/60);

    spielerX += richtungX*aktuellesTempo()*deltaFaktor;

    spielerY += richtungY*aktuellesTempo()*deltaFaktor;

    let welt =
    GROESSE*FELD;

    if(spielerX<0)

    spielerX=0;

    if(spielerY<0)

    spielerY=0;

    if(spielerX>welt-FELD)

    spielerX=welt-FELD;

    if(spielerY>welt-FELD)

    spielerY=welt-FELD;

    karte.style.transform=

    `translate3d(${
    -(spielerX-window.innerWidth/2+FELD/2)
    }px,${
    -(spielerY-window.innerHeight/2+FELD/2)
    }px,0)`;

    // Spieler steht immer in der Bildmitte - nur bei Groessenaenderung neu setzen

    if(spieler.dataset.mitteB!==String(window.innerWidth) ||
       spieler.dataset.mitteH!==String(window.innerHeight)){

        spieler.style.left=window.innerWidth/2+"px";

        spieler.style.top=window.innerHeight/2+"px";

        spieler.dataset.mitteB=window.innerWidth;

        spieler.dataset.mitteH=window.innerHeight;

    }

    if(richtungX!==0 || richtungY!==0){

        spieler.classList.add("laeuft");

    }else{

        spieler.classList.remove("laeuft");

    }

    pruefePflanzenKollision();

    pruefeBeerenKollision();

    versucheKisteOeffnen(deltaMs);

    aktualisierePetHelfer(deltaMs,deltaFaktor);

    aktualisierePets(deltaFaktor);

    diagTick();

    requestAnimationFrame(update);

}

