// Hauptfunktion für Aufgaben-Prüfung
function pruefeAufgaben(){

    let hatSichGeaendert = false;

    // Schaue ob Aufgaben fertig sind
    aktiveAufgaben.forEach(aufgabe=>{

        let fertig =
        aufgabe.anforderungen.every(
            a=>a.fortschritt>=a.ziel
        );

        if(fertig && !aufgabe.abgeschlossen){

            aufgabe.abgeschlossen=true;
            hatSichGeaendert = true;

            // Animation für fertige Aufgabe
            if(aufgabenListeHTML){

                let karte=
                aufgabenListeHTML.querySelector(
                    `[data-aufgabe-id="${aufgabe.id}"]`
                );

                if(karte){
                    spieleCoinFlugAnimation(karte);
                }

            }

            // Belohnungen
            coins+=aufgabe.belohnung;

            xp+=Math.round(
                aufgabe.xp*ausruestungsXpMultiplikator()
            );

            erledigteAufgaben.push(
                aufgabe.id
            );

            if(typeof questFortschritt==="function"){

                questFortschritt("auftraege",1);

            }

            // Lager-Upgrade durchführen
            let istLagerAufgabe=
            aufgabe.anforderungen.some(
                a=>a.typ==="lager"
            );

            if(istLagerAufgabe){

                gewaehreLagerBelohnung();

            }

        }

    });

    // Entferne fertige Aufgaben
    aktiveAufgaben =
    aktiveAufgaben.filter(
        a=>!a.abgeschlossen
    );

    // Max-Level erreicht: aufgabenListe hat keine Einträge mehr für
    // dieses Level (aktuell nur bis Level 50 befüllt). Statt
    // abzustürzen, einfach nichts mehr laden/prüfen - das Spiel
    // läuft in diesem Zustand einfach weiter.

    if(!aufgabenListe[level]){

        aktualisiereAnzeige();

        if(hatSichGeaendert){
            zeigeAufgaben();
        } else {
            aktualisiereAufgabenAnzeige();
        }

        return;

    }

    // Lade neue normale Aufgaben
    let offene =
    aufgabenListe[level]
    .filter(
        a=>
        !erledigteAufgaben.includes(a.id) &&
        !aktiveAufgaben.some(ak=>ak.id===a.id) &&
        !a.isLagerUpgrade
    );

    while(
        aktiveAufgaben.length<2 &&
        offene.length>0
    ){

        let neu =
        offene.shift();

        aktiveAufgaben.push(
            klonAufgabe(neu)
        );
        
        hatSichGeaendert = true;

    }

    // Wenn alle normalen Aufgaben erledigt: Lager-Aufgabe laden
    
    let allNormalErledigt = 
    aufgabenListe[level]
    .filter(a => !a.isLagerUpgrade)
    .every(a => erledigteAufgaben.includes(a.id));

    if(allNormalErledigt && aktiveAufgaben.length < 3){
        
        let lagerAufgabe = aufgabenListe[level].find(a => a.isLagerUpgrade && !erledigteAufgaben.includes(a.id));
        
        if(lagerAufgabe && !aktiveAufgaben.some(ak => ak.id === lagerAufgabe.id)){
            
            aktiveAufgaben.push(klonAufgabe(lagerAufgabe));
            hatSichGeaendert = true;
            
        }
        
    }

    // Level-UP wenn ALLE Aufgaben erledigt
    let levelFertig =
    aufgabenListe[level]
    .every(
        a=>erledigteAufgaben.includes(a.id)
    );

    if(levelFertig){

        level++;

        sterne+=1;

        if(typeof questFortschritt==="function"){

            questFortschritt("level",1);

        }

        erledigteAufgaben=[];

        aktiveAufgaben=[];
        
        // Update Karten-Größe für neues Level
        kartenStufe = karteSizeForLevel(level);
        plattformGroesse = kartenStufe;
        aktualisierePlattform();
        aktualisiereLagerPosition();
        aktualisiereSpawnRate();
        
        // Beeren-Zaehler zuruecksetzen fuer neues Level

        setzeBeerenZurueck();
        
        hatSichGeaendert = true;

        // Alle bestehenden Pflanzen entfernen und neu spawnen, damit
        // frisch freigeschaltete Sorten (z.B. Brokkoli ab Level 29)
        // sofort erscheinen können, statt auf zufälliges Nachwachsen
        // einer geernteten Pflanze zu warten.

        pflanzen.forEach(p=>{

            if(p.element)p.element.remove();

        });

        pflanzen=[];

        for(let i=0;i<pflanzenZiel();i++){

            pflanzeErstellen();

        }

        if(aufgabenListe[level]){

            starteAufgaben();

        }

    }

    aktualisiereAnzeige();

    // Update UI nur wenn nötig
    if(hatSichGeaendert){
        zeigeAufgaben();
    } else {
        aktualisiereAufgabenAnzeige();
    }

}


// Charakter-Skills: 3 feste Skills, pro Spieler-Level wird 1 weitere Stufe
// in JEDEM der 3 Skills freigeschaltet (also 3 neue Stufen pro Level-Up),
// bis maximal Stufe 50. Jede Stufe bringt nur einen kleinen Schritt.

// ============================================
// CHARAKTER-KETTE
//
// 30 Knoten in 10 Gruppen. Jede Gruppe hat drei Knoten -
// Erntebereich, Sammelradius und Tempo. Eine Gruppe geht auf,
// sobald der Spieler das passende Level erreicht hat:
// Gruppe 1 ab Level 10, Gruppe 2 ab Level 20, und so weiter
// bis Gruppe 10 ab Level 100.
//
// Bezahlt wird mit Muenzen. Der Preis verdoppelt sich pro
// Gruppe: 80, 160, 320 ... bis 40.960.
// ============================================

const SKILL_GRUPPEN=10;

const SKILL_STUFE_PRO_GRUPPE=10;

const SKILL_ARTEN={

    erntebereich:{

        name:"Erntebereich",
        icon:"🪓",
        schritt:1.2,
        einheit:" px"

    },

    sammelradius:{

        name:"Sammelradius",
        icon:"🧲",
        schritt:1.5,
        einheit:" px"

    },

    tempo:{

        name:"Bewegungsgeschwindigkeit",
        icon:"👟",
        schritt:0.03,
        einheit:""

    }

};

const SKILL_REIHENFOLGE=["erntebereich","sammelradius","tempo"];

// Gekaufte Knoten, Schluessel ist "typ_gruppe"

let gekaufteKnoten={};

function skillGruppenLevel(gruppe){

    return gruppe*SKILL_STUFE_PRO_GRUPPE;

}

function skillKnotenKosten(gruppe){

    return 80*Math.pow(2,gruppe-1);

}

function skillKnotenGekauft(typ,gruppe){

    return gekaufteKnoten[typ+"_"+gruppe]===true;

}

function skillGruppeOffen(gruppe){

    return level>=skillGruppenLevel(gruppe);

}

// Wie viele Knoten einer Art gekauft wurden

function skillAnzahl(typ){

    let summe=0;

    for(let g=1;g<=SKILL_GRUPPEN;g++){

        if(skillKnotenGekauft(typ,g))summe++;

    }

    return summe;

}

// ---- Die drei Boni, die daraus entstehen ----

function skillErntebereichBonus(){

    return skillAnzahl("erntebereich")*SKILL_ARTEN.erntebereich.schritt;

}

function skillSammelradiusBonus(){

    return skillAnzahl("sammelradius")*SKILL_ARTEN.sammelradius.schritt;

}

function skillTempoBonus(){

    return skillAnzahl("tempo")*SKILL_ARTEN.tempo.schritt;

}

const BASIS_TEMPO=2.5;

function aktuellesTempo(){

    return BASIS_TEMPO+
    skillTempoBonus()+
    ausruestungsTempoBonus();

}

