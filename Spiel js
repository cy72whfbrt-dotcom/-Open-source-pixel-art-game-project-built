let richtungX=0;

let richtungY=0;

let halten=false;

joystick.addEventListener("touchstart",()=>{

    halten=true;

});

joystick.addEventListener("touchmove",e=>{

    if(!halten)return;

    let finger=e.touches[0];

    let box=
    joystick.getBoundingClientRect();

    let dx=
    finger.clientX-(box.left+50);

    let dy=
    finger.clientY-(box.top+50);

    let max=35;

    let entfernung=
    Math.sqrt(
        dx*dx+
        dy*dy
    );

    if(entfernung>max){

        dx=
        dx/entfernung*max;

        dy=
        dy/entfernung*max;

    }

    knopf.style.left=
    30+dx+"px";

    knopf.style.top=
    30+dy+"px";

    richtungX=
    dx/max;

    richtungY=
    dy/max;

});

joystick.addEventListener("touchend",()=>{

    halten=false;

    richtungX=0;

    richtungY=0;

    knopf.style.left="28px";

    knopf.style.top="28px";

});

// WASD-Tastatursteuerung (zusätzlich zum Joystick, keine eigene Anzeige)

let tasten={w:false,a:false,s:false,d:false};

function aktualisiereTastaturRichtung(){

    let x=
    (tasten.d?1:0)-(tasten.a?1:0);

    let y=
    (tasten.s?1:0)-(tasten.w?1:0);

    if(x!==0 || y!==0){

        let laenge=
        Math.sqrt(x*x+y*y);

        richtungX=x/laenge;

        richtungY=y/laenge;

    }else if(!halten){

        richtungX=0;

        richtungY=0;

    }

}

window.addEventListener("keydown",e=>{

    let taste=e.key.toLowerCase();

    if(tasten.hasOwnProperty(taste)){

