    aktualisiereAnzeige();

    setTimeout(()=>{

        kiste.element.remove();

        let index=kisten.indexOf(kiste);

        if(index>-1)kisten.splice(index,1);

    },600);

}

function zeichneKistenRing(kiste){

    if(!kiste.ringElement || !kiste.bildElement)return;

    if(kiste.progress<=0){

        // Nichts angefangen: nur das Kisten-Symbol zeigen

        kiste.ringElement.style.display="none";

        kiste.bildElement.style.display="block";

        return;

    }

    kiste.ringElement.style.display="block";

    kiste.bildElement.style.display="none";

    let anteil=(kiste.progress/100);

    kiste.ringElement.style.background=
    "conic-gradient(#f5b820 0turn "+anteil.toFixed(3)+
    "turn, #26333f "+anteil.toFixed(3)+"turn 1turn)";

}

function versucheKisteOeffnen(deltaMs){

    let schritt=100*(deltaMs/KISTE_DAUER);

    for(let i=kisten.length-1;i>=0;i--){

        let k=kisten[i];

        if(!k.aktiv)continue;

        // Die Kiste sitzt wegen ihrer negativen Raender optisch
        // MITTIG auf k.x/k.y - vorher wurde hier k.x+20 gerechnet,
        // dadurch lag der Auslesepunkt schraeg daneben.

        let dx=(spielerX+16)-k.x;

        let dy=(spielerY+16)-k.y;

        let nah=Math.sqrt(dx*dx+dy*dy)<KISTE_REICHWEITE;

        let vorher=k.progress;

        if(nah){

            k.progress=Math.min(100,k.progress+schritt);

        }else{

            // Geht der Spieler weg, laeuft der Kreis wieder zurueck

            k.progress=Math.max(0,k.progress-schritt*KISTE_RUECKLAUF);

        }

        if(k.progress!==vorher)zeichneKistenRing(k);

        if(k.progress>=100)oeffneKiste(k);

    }

}

