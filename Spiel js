        ertragStufe:ertragStufe,
        petLevels:pets.map(p=>p.level)

    };

}

function speichereSpiel(){

    try{

        localStorage.setItem(
            SPEICHER_SCHLUESSEL,
            JSON.stringify(sammleSpielstand())
        );

    }catch(e){

        // localStorage evtl. nicht verfügbar - Spiel läuft trotzdem weiter

    }

}

function ladeSpielstand(){

    try{

        let roh=
        localStorage.getItem(SPEICHER_SCHLUESSEL);

        if(!roh)return null;

        return JSON.parse(roh);

    }catch(e){

        return null;

    }

}

function wendeSpielstandAn(d){

    if(!d)return;

    if(typeof d.coins==="number")coins=d.coins;

    if(typeof d.juwelen==="number")juwelen=d.juwelen;

    if(typeof d.sterne==="number")sterne=d.sterne;

    if(typeof d.level==="number")level=d.level;

    if(typeof d.xp==="number")xp=d.xp;

    if(typeof d.lilie==="number")lilie=d.lilie;

    if(d.gekaufteKnoten){

        gekaufteKnoten=d.gekaufteKnoten;

    }

    if(typeof d.lagerLevel==="number")lagerLevel=d.lagerLevel;

    if(typeof d.kartenStufe==="number"){

        kartenStufe=d.kartenStufe;

        plattformGroesse=kartenStufe;

    }

    if(d.ausruestungsInventar){

        ausruestungsInventar=d.ausruestungsInventar;

    }

    if(d.erledigteAufgaben){

        erledigteAufgaben=d.erledigteAufgaben;

    }

    if(d.ertragStufe){

        Object.keys(d.ertragStufe).forEach(k=>{

            if(ertragStufe.hasOwnProperty(k)){

                ertragStufe[k]=d.ertragStufe[k];

            }

        });

    }

    if(Array.isArray(d.petLevels)){

        pets.forEach(p=>p.element.remove());

        pets.length=0;

        d.petLevels.forEach(lvl=>{

            petErstellen();

            pets[pets.length-1].level=lvl;

        });

    }

    aktualisierePlattform();

    aktualisiereLagerPosition();

    starteAufgaben();

    aktualisiereAnzeige();

}

