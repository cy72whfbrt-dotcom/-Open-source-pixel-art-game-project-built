        if(!gesammelteBeeren.hasOwnProperty(e.art)){

            gesammelteBeeren[e.art]=0;

        }

        gesammelteBeeren[e.art]+=e.menge;

        beeren+=e.menge;

        aktualisiereAufgabenFortschritt(e.art,gesammelteBeeren[e.art]);

    });

