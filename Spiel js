function zeichneDetail(){

    const item=gewaehltesItem;

    if(!item)return;

    const t=TEILE[item.slot];

    const b=BUFFS[item.buff];

    $("ausrDTitel").textContent=t.name;

    $("ausrDRahmen").style.background=SELTENHEIT[item.seltenheit].farbe;

    $("ausrDRahmen").innerHTML=teilBild(item.slot,70);

    $("ausrDText").textContent=t.text;

    $("ausrDBuffName").textContent=b.name;

    $("ausrDBuffWert").textContent="+"+item.staerke.toFixed(b.komma)+b.einheit;

    $("ausrDLevel").textContent="Level: "+item.stufe+"/"+MAX_STUFE;

    const eigen=RANG.indexOf(item.seltenheit);

    $("ausrDEffekte").innerHTML=["gruen","blau","lila","gold"].map(s=>

        '<div class="ausrEffektZeile'+(RANG.indexOf(s)<=eigen?" frei":"")+'">'+
        '<span class="ausrPunkt" style="background:'+SELTENHEIT[s].punkt+'"></span>'+
        t.effekte[s]+'</div>'

    ).join("");

    const kosten=upgradeKosten(item);

    const max=item.stufe>=MAX_STUFE;

    $("ausrDKosten").innerHTML = max
    ? "Maximale Stufe erreicht"
    : bild(BILD.muenze,22)+holeMuenzen().toLocaleString("de-DE")+
      " / "+kosten.toLocaleString("de-DE");

    $("ausrBtnAusruesten").textContent=istAngelegt(item)?"Ablegen":"Ausrüsten";

    $("ausrBtnUpgrade").className="ausrDBtn b2"+((max||holeMuenzen()<kosten)?" aus":"");

    $("ausrBtnMax").className="ausrDBtn b3"+(max?" aus":"");

}

// ============================================================
// KOMBINIEREN
// ============================================================

function kombiniere(){

    const gruppen={};

    inventar.forEach(i=>{

        if(i.seltenheit==="gold")return;

        const k=i.slot+"_"+i.seltenheit;

        if(!gruppen[k])gruppen[k]=[];

        gruppen[k].push(i);

    });

    let gemacht=false;

    for(const k in gruppen){

        const liste=gruppen[k];

        while(liste.length>=3){

            const drei=liste.splice(0,3);

            drei.forEach(i=>{

                if(istAngelegt(i))angelegt[i.slot]=null;

                inventar=inventar.filter(x=>x.id!==i.id);

            });

            const v=drei[0];

            inventar.push(
                baueItem(v.slot,RANG[RANG.indexOf(v.seltenheit)+1],v.stufe)
            );

            gemacht=true;

        }

    }

    if(!gemacht){

        alert("Du brauchst 3 gleiche Teile derselben Farbe.");

    }

    zeichneHub();

    speichern();

}

