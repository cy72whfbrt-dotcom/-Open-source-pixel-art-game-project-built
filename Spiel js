(function(){

// ---- Bilder ------------------------------------------------

const Q_BILD={

    quest :{pfad:"GameCSS/Clipboard_Outline_256.png",  ersatz:"📋"},
    truhe :{pfad:"GameCSS/Chest_Medium_1_1_256.png",   ersatz:"📦"},
