function petFeldFrei(nummer){

    // Die ersten Felder sind offen, die letzten haengen am Level

    if(nummer<PET_FELDER)return true;

    return holeLevel()>=PET_FREI_AB_LEVEL;

}

function zeichnePets(){

    const raster=$("ausrPetRaster");

    if(!raster)return;

    let html="";

    for(let i=0;i<PET_FELDER+PET_GESPERRT;i++){

        if(petFeldFrei(i)){

            let gewaehlt=gewaehltesPetFeld===i?" gewaehlt":"";

            html+='<div class="ausrPetFeld ausrPetLeer'+gewaehlt+'" data-pet="'+i+'">'+
                  bild(BILD.pfote,32)+'</div>';

        }else{

            html+='<div class="ausrPetFeld gesperrt">'+
                  bild(BILD.schloss,26)+
                  '<span class="stufe">Level '+PET_FREI_AB_LEVEL+'</span></div>';

        }

    }

    raster.innerHTML=html;

    raster.querySelectorAll("[data-pet]").forEach(feld=>{

        feld.onclick=()=>{

            let nummer=Number(feld.dataset.pet);

            gewaehltesPetFeld=gewaehltesPetFeld===nummer?null:nummer;

            zeichnePets();

            zeichnePetSlot();

        };

    });

}

function zeichnePetSammlung(){

    const box=$("ausrPetSammlung");

    if(!box)return;

    if(meinePets.length===0){

        box.innerHTML=

        '<div class="ausrPetLeerBlock">'+
        '<div class="ausrPetLeerText">Noch nichts da</div>'+
        '<div class="ausrZuTruhenBtn" id="ausrZuTruhen">'+
        bild(BILD.truhe,22)+'<span>Zu Truhen wechseln</span></div>'+
        '</div>';

        let knopf=$("ausrZuTruhen");

        if(knopf){

            knopf.onclick=()=>{ zeichneShop(); zeigeOverlay("ausrShop"); };

        }

        return;

    }

    box.innerHTML=meinePets.map((pet,i)=>

        '<div class="ausrPetKarte'+(angelegtesPetId===pet.id?" angelegtesPet":"")+
        '" data-meinpet="'+i+'" '+
        'style="background:'+SELTENHEIT[pet.seltenheit].farbe+'">'+
        slimeBild(pet.datei,34)+'</div>'

    ).join("");

    box.querySelectorAll("[data-meinpet]").forEach(karte=>{

        karte.onclick=()=>{

            zeigePetDetail(meinePets[Number(karte.dataset.meinpet)]);

        };

    });

}

let gewaehltesPet=null;

function zeigePetDetail(pet){

    gewaehltesPet=pet;

    zeichnePetDetail();

    zeigeOverlay("ausrPetDetail");

}

function zeichnePetDetail(){

    const pet=gewaehltesPet;

    if(!pet)return;

    const angelegt=angelegtesPetId===pet.id;

    $("ausrPDTitel").textContent=pet.name;

    $("ausrPDRahmen").style.background=SELTENHEIT[pet.seltenheit].farbe;

    $("ausrPDRahmen").innerHTML=slimeBild(pet.datei,70);

    $("ausrPDRadius").textContent=String(petRadiusFelder(pet)).replace(".",",")+" Felder";

    $("ausrPDLevel").textContent="Level: "+pet.stufe+"/"+PET_MAX_STUFE;

    let sekunden=(petIntervall(pet)/1000).toFixed(1).replace(".",",");

    let bonus=Math.round(petErtragBonus(pet)*100);

    $("ausrPDWerte").innerHTML=

    '<div class="ausrEffektZeile frei">'+
    '<span class="ausrPunkt" style="background:'+SELTENHEIT[pet.seltenheit].punkt+'"></span>'+
    'Stufe '+SELTENHEIT[pet.seltenheit].name+'</div>'+

    '<div class="ausrEffektZeile frei">'+
    '<span class="ausrPunkt" style="background:#5cd23c"></span>'+
    'Erntet im Umkreis von '+String(petRadiusFelder(pet)).replace(".",",")+' Feldern</div>'+

    '<div class="ausrEffektZeile frei">'+
    '<span class="ausrPunkt" style="background:#3a9fdd"></span>'+
    'Alle '+sekunden+' Sekunden eine Pflanze</div>'+

    '<div class="ausrEffektZeile'+(bonus>0?" frei":"")+'">'+
    '<span class="ausrPunkt" style="background:#f0b41c"></span>'+
    'Bonus-Ertrag +'+bonus+'%</div>';

    const kosten=petUpgradeKosten(pet);

    const max=pet.stufe>=PET_MAX_STUFE;

    $("ausrPDKosten").innerHTML = max
    ? "Maximale Stufe erreicht"
    : bild(BILD.muenze,22)+holeMuenzen().toLocaleString("de-DE")+
      " / "+kosten.toLocaleString("de-DE");

    $("ausrPDAnlegen").textContent=angelegt?"Ablegen":"Ausruesten";

    $("ausrPDUpgrade").className="ausrDBtn b2"+((max||holeMuenzen()<kosten)?" aus":"");

    $("ausrPDMax").className="ausrDBtn b3"+(max?" aus":"");

}

function zeichnePetSlot(){

    const slot=$("ausrPetSlot");

    if(!slot)return;

    const pet=angelegtesPet();

    if(pet){

        slot.className="ausrSlot ausrPetSlot belegt";

        slot.style.background=SELTENHEIT[pet.seltenheit].farbe;

        slot.innerHTML=slimeBild(pet.datei,38)+
