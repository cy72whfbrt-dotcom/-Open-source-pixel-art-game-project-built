const Q_HTML=`

<div id="questKnopf"></div>

<div class="questOverlay" id="questFenster">
<div class="questKopf">
<div class="questTitel">Aufgaben</div>
<div class="questX" id="questSchliessen">&#10005;</div>
</div>
<div class="questBox" id="questInhalt"></div>
</div>

`;

// ============================================================
// ZEICHNEN
// ============================================================

function zeichne(){

    const box=document.getElementById("questInhalt");

    if(!box)return;

    pruefeTagwechsel();

    let hoechste=TAGESTRUHEN[TAGESTRUHEN.length-1].marke;

    let anteil=Math.min(100,(trophaeen/hoechste)*100);

    let html="";

    // ---- Balken mit Truhen ----

    html+='<div class="questBalkenBox"><div class="questBalkenReihe">';

    html+='<div class="questPokal">🏆<span>'+trophaeen+'</span></div>';

    html+='<div class="questSchiene"><div class="questSchieneVoll" '+
    'style="width:'+anteil+'%"></div></div>';

    html+='<div class="questMarken">';

    TAGESTRUHEN.forEach((t,i)=>{

        let geholt=truhenAbgeholt[i];

        let bereit=!geholt && trophaeen>=t.marke;

        let klasse=geholt?"geholt":(bereit?"bereit":"gesperrt");

        html+='<div class="questMarke '+klasse+'" data-truhe="'+i+'">'+
        '<div class="questMarkeBild">'+qBild(Q_BILD.truhe,34)+'</div>'+
        '<div class="questMarkeZahl">'+t.marke+'</div>'+
        '</div>';

    });

    html+='</div></div>';

    html+='<div class="questNeustart">Neustart in: '+restZeitText()+'</div>';

    html+='</div>';

    // ---- Die zehn Zeilen ----

    TAGESAUFGABEN.forEach(a=>{

        let wert=fortschritt[a.kennung]||0;

        let fertig=wert>=a.ziel;

        let geholt=abgeholt[a.kennung];

        let anteilZeile=Math.min(100,(wert/a.ziel)*100);

        let knopf=geholt

            ? '<div class="questHolBtn aus">Erhalten</div>'

            : (fertig
               ? '<div class="questHolBtn" data-hol="'+a.kennung+'">Beanspruchen</div>'
               : '<div class="questHolBtn aus">Beanspruchen</div>');

        html+=

        '<div class="questZeile'+(fertig&&!geholt?" fertig":"")+'">'+

        '<div class="questZeilePokal">🏆<span>'+a.trophaeen+'</span></div>'+

        '<div class="questZeileMitte">'+
        '<div class="questZeileText">'+a.text+'</div>'+
        '<div class="questZeileBalken">'+
        '<div class="questZeileVoll" style="width:'+anteilZeile+'%"></div>'+
        '<div class="questZeileZahl">'+wert+'/'+a.ziel+'</div>'+
        '</div>'+
        '</div>'+

        knopf+

        '</div>';

    });

    box.innerHTML=html;

    box.querySelectorAll("[data-hol]").forEach(el=>{

        el.onclick=()=>holeAufgabe(el.dataset.hol);

    });

    box.querySelectorAll("[data-truhe]").forEach(el=>{

        el.onclick=()=>holeTruhe(Number(el.dataset.truhe));

    });

}

// ============================================================
// AUFBAU
// ============================================================

function baueAuf(){

    let stil=document.createElement("style");

    stil.textContent=Q_CSS;

    document.head.appendChild(stil);

    let huelle=document.createElement("div");

    huelle.innerHTML=Q_HTML;

    while(huelle.firstElementChild){

        document.body.appendChild(huelle.firstElementChild);

    }

    let knopf=document.getElementById("questKnopf");

    if(knopf){

        knopf.innerHTML=qBild(Q_BILD.quest,34)+
        '<span class="beschriftung">QUEST</span>';

        knopf.onclick=()=>{

            questOffen=true;

            zeichne();

            document.getElementById("questFenster").classList.add("offen");

        };

    }

    let zu=document.getElementById("questSchliessen");

    if(zu){

        zu.onclick=()=>{

            questOffen=false;

            document.getElementById("questFenster").classList.remove("offen");

        };

    }

    let fenster=document.getElementById("questFenster");

    if(fenster){

        fenster.onclick=e=>{

            if(e.target===fenster){

                questOffen=false;

                fenster.classList.remove("offen");

            }

        };

    }

}

function start(){

    baueAuf();

    lade();

    aktualisiereHinweis();

    // Einmal pro Minute die Restzeit auffrischen und den
    // Tageswechsel bemerken

    // Restzeit auffrischen und Tageswechsel bemerken

    setInterval(()=>{

        if(pruefeTagwechsel())aktualisiereHinweis();

        if(questOffen)zeichne();

    },60000);

    // Aufgesammelte Aenderungen wegschreiben

    setInterval(sichereJetzt,2000);

    window.addEventListener("pagehide",sichereJetzt);

}

if(document.readyState==="loading"){

    document.addEventListener("DOMContentLoaded",start);

}else{

    start();

}

})();

