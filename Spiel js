function zeichneHub(){

    zeichneSlots();

    zeichnePetSlot();

    zeichneBuffs();

    zeichneInventar();

    $("ausrSpielerBild").innerHTML=bild(BILD.spieler,110);

}

function zeichneSlots(){

    // Nur die sechs echten Teile-Slots. Der Pfoten-Slot traegt
    // dieselbe Klasse fuers Aussehen, hat aber kein data-slot.

    document.querySelectorAll(".ausrSlot[data-slot]").forEach(el=>{

        const slot=el.dataset.slot;

        const item=angelegt[slot];

        if(item){

            el.className="ausrSlot belegt";

            el.style.background=SELTENHEIT[item.seltenheit].farbe;

            el.innerHTML=teilBild(slot,34)+
            '<span class="ausrSlotStufe">'+item.stufe+'</span>';

            el.onclick=()=>zeigeDetail(item);

        }else{

            el.className="ausrSlot leer";

            el.style.background="";

            el.innerHTML=teilBild(slot,34);

            el.onclick=null;

        }

    });

}

function zeichneBuffs(){

    const summe=buffSummen();

    $("ausrBuffListe").innerHTML=Object.keys(BUFFS).map(k=>

        '<div class="ausrBuffZeile'+(summe[k]>0?"":" aus")+'">'+
        buffText(k,summe[k])+'</div>'

    ).join("");

}

function zeichneInventar(){

    const box=$("ausrInventar");

    if(!inventar.length){

        box.innerHTML='<div class="ausrLeerHinweis">Noch nichts da –<br>hol dir was aus den Truhen!</div>';

        return;

    }

    const liste=inventar.slice().sort((a,b)=>

        sortLevel
        ? b.stufe-a.stufe
        : RANG.indexOf(b.seltenheit)-RANG.indexOf(a.seltenheit)

    );

    box.innerHTML="";

    liste.forEach(item=>{

        const el=document.createElement("div");

        el.className="ausrInvItem"+(istAngelegt(item)?" angelegt":"");

        el.style.background=SELTENHEIT[item.seltenheit].farbe;

        el.innerHTML='<span class="ausrStufeBadge">Lv.'+item.stufe+'</span>'+
        teilBild(item.slot,30);

        el.onclick=()=>zeigeDetail(item);

        box.appendChild(el);

    });

}

