// Fuellzeit des Kreises in Millisekunden

const KISTE_DAUER=2000;

// Ab welcher Entfernung die Kiste anspringt, in Pixeln.
// Ein Feld ist 40 Pixel breit, die Kiste selbst ist 40 breit
// und 48 hoch, der Spieler 32 - 40 heisst also grob
// "beruehrt sie".

const KISTE_REICHWEITE=40;

// Wie schnell der Kreis zurueckfaellt, wenn man weggeht.
// 1 = genauso schnell wie er sich fuellt.

const KISTE_RUECKLAUF=1.4;

// Beute: drei verschiedene Sorten, je 10 bis 50 Stueck.
// Die Ertragsstufen aus dem Verbessern-Hub zaehlen mit.

function kistenBeute(){

    let sorten=verfuegbareSortenFuerKiste();

    let auswahl=[];

    while(auswahl.length<3 && sorten.length>0){

        let i=Math.floor(Math.random()*sorten.length);

        auswahl.push(sorten.splice(i,1)[0]);

    }

    return auswahl.map(art=>{

        let grund=10+Math.floor(Math.random()*41);

        let stufe=1;

        if(typeof ertragStufe!=="undefined" && ertragStufe[art]){

            stufe=ertragStufe[art];

        }

        let menge=Math.max(1,Math.round(
            grund*stufe*ausruestungsErtragMultiplikator()
        ));

        return {art:art,menge:menge};

    });

}

function verfuegbareSortenFuerKiste(){

    return verfügbareBüsche().slice();

}

function zeigeKistenBeute(kiste,beute){

