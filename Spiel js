// Ertrag pro Ernte je Sorte - wird mit Gold hochgekauft

let ertragStufe={};

HUB_PFLANZEN.forEach(p=>{

    ertragStufe[p.typ]=1;

});

function ertragKosten(typ){

    let stufe=ertragStufe[typ]||1;

    let index=HUB_PFLANZEN.findIndex(p=>p.typ===typ);

    return Math.round(
        (40+index*25)*Math.pow(1.35,stufe-1)
    );

}

function zahlKurz(zahl){

    if(zahl>=1000000)return (zahl/1000000).toFixed(2).replace(".",",")+"M";

    if(zahl>=1000)return (zahl/1000).toFixed(2).replace(".",",")+"k";

    return zahl;

}

function hubKarteHtml(eintrag){

    let typ=eintrag.typ;

    let frei=level>=eintrag.abLevel;

    let ertrag=ertragStufe[typ]||1;

    let kosten=ertragKosten(typ);

    let bezahlbar=coins>=kosten;

    let btn=!frei

        ? `<div class="hubBtn gesperrt">🔒 Level ${eintrag.abLevel}</div>`

        : `<div class="hubBtn ${bezahlbar?"":"zuTeuer"}" data-upgrade="${typ}">
           <span class="hubBtnMuenze"></span> ${zahlKurz(kosten)}
           </div>`;

    return `

    <div class="hubKarte">

        <div class="hubKarteKopf">

            <div class="hubIcon">
                <img src="BushCSS/${typ}-outline-256.png" alt="">
            </div>

            <div class="hubName">${eintrag.name}</div>

        </div>

        <div class="hubErnte"><b>${ertrag}</b> Pro Ernte</div>

        ${btn}

    </div>

    `;

}

function bestesUpgradeHtml(){

    let offene=HUB_PFLANZEN.filter(p=>level>=p.abLevel);

    if(offene.length===0)return "";

    let guenstigste=offene.reduce((a,b)=>
        ertragKosten(a.typ)<=ertragKosten(b.typ)?a:b
    );

    let typ=guenstigste.typ;

    let kosten=ertragKosten(typ);

    let bezahlbar=coins>=kosten;

    return `

    <div class="hubIcon">
        <img src="BushCSS/${typ}-outline-256.png" alt="">
    </div>

    <div class="bestesUpgradeText">
        <div class="bestesUpgradeName">${guenstigste.name}</div>
        <div class="bestesUpgradeErnte"><b>${ertragStufe[typ]}</b> Pro Ernte</div>
    </div>

    <div class="hubBtn ${bezahlbar?"":"zuTeuer"}" data-upgrade="${typ}">
        <span class="hubBtnMuenze"></span> ${zahlKurz(kosten)}
    </div>

    `;

}

function kaufeErtrag(typ){

    let eintrag=HUB_PFLANZEN.find(p=>p.typ===typ);

    if(!eintrag || level<eintrag.abLevel)return;

    let kosten=ertragKosten(typ);

    if(coins<kosten)return;

    coins-=kosten;

    ertragStufe[typ]++;

    if(typeof questFortschritt==="function"){

        questFortschritt("ertrag",1);

    }

    aktualisiereAnzeige();

    renderAufwertenPanel();

}

