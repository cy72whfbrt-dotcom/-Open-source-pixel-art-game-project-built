// Coin-Icon für die Flug-Animation bei abgeschlossenen Aufgaben

const COIN_SVG=`<svg viewBox="0 0 512 512">
<path fill="#EFB832" d="M256,512C114.841,512,0,397.159,0,256S114.841,0,256,0s256,114.841,256,256S397.159,512,256,512z"/>
<circle fill="#CC9322" cx="256" cy="256" r="150"/>
<circle fill="#EFB832" cx="256" cy="256" r="120"/>
</svg>`;

function spieleCoinFlugAnimation(vonElement){

    if(!vonElement || !coinsText)return;

    let startRect=
    vonElement.getBoundingClientRect();

    let zielRect=
    coinsText.getBoundingClientRect();

    let anzahl=4;

    for(let i=0;i<anzahl;i++){

        setTimeout(()=>{

            let coin=
            document.createElement("div");

            coin.className="coinFlug";

            coin.innerHTML=COIN_SVG;

            let winkel=
            Math.random()*Math.PI*2;

            let entfernung=
            20+Math.random()*30;

            let versatzX=
            Math.cos(winkel)*entfernung;

            let versatzY=
            Math.sin(winkel)*entfernung;

            let startX=
            startRect.left+startRect.width/2;

            let startY=
            startRect.top+startRect.height/2;

            let endX=
            zielRect.left+zielRect.width/2-startX+versatzX;

            let endY=
            zielRect.top+zielRect.height/2-startY+versatzY;

            coin.style.left=startX+"px";

            coin.style.top=startY+"px";

            coin.style.setProperty("--tx",endX+"px");

            coin.style.setProperty("--ty",endY+"px");

            coin.style.setProperty("--tx-mid",(endX*0.6)+"px");

            coin.style.setProperty("--ty-mid",(endY*0.6)+"px");

            document.body.appendChild(coin);

            requestAnimationFrame(()=>{

                coin.classList.add("fliegt");

            });

            setTimeout(()=>{

                coin.remove();

            },1000);

        },i*60);

    }

}

// SCHNELLE Funktion um nur Fortschritt-Zahlen zu aktualisieren (ohne ganz neuzeichnen!)
function aktualisiereAufgabenAnzeige(){
    
    if(!aufgabenListeHTML) return; // Guard clause
    
    aktiveAufgaben.forEach(aufgabe => {
        
        // Wenn Element nicht gecacht: neu suchen
        if(!aufgabe.fortschrittElement){
            
            let karte = aufgabenListeHTML.querySelector(
                `[data-aufgabe-id="${aufgabe.id}"]`
            );
            
            if(karte){
                aufgabe.fortschrittElement = karte.querySelector('.aufgaben-fortschritt');
            }
            
        }
        
        // Nur wenn Element existiert
        if(aufgabe.fortschrittElement){
            
            let hauptAnforderung = aufgabe.anforderungen[0];
            
            aufgabe.fortschrittElement.textContent = `${hauptAnforderung.fortschritt}/${hauptAnforderung.ziel}`;
            
        }
        
    });
    
}

