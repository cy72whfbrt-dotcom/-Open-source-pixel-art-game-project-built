    for(let i=liegendeBeeren.length-1;i>=0;i--){

        let b=liegendeBeeren[i];

        if(!b || !b.aktiv)continue;

        let dx=mitteX-b.x;

        let dy=mitteY-b.y;

        if(dx*dx+dy*dy>=aktuellerSammelRadiusQuadrat())continue;

        b.aktiv=false;

        b.element.remove();

        liegendeBeeren.splice(i,1);

        // Ertragsstufe aus dem Verbessern-Hub: eine aufgesammelte
        // Beere zaehlt so oft, wie die Stufe hoch ist

        let ertrag=1;

        if(b.art && typeof ertragStufe!=="undefined" && ertragStufe[b.art]){

            ertrag=ertragStufe[b.art];

        }

        ertrag=Math.round(ertrag*ausruestungsErtragMultiplikator());

        beeren+=ertrag;

        if(b.art){

            if(!gesammelteBeeren.hasOwnProperty(b.art)){

                gesammelteBeeren[b.art]=0;

