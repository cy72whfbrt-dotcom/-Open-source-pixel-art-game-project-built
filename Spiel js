// ============================================
// SKALIERUNGSFAKTOREN je Buff
// Die rohe "Stärke" eines Items (siehe baueItem/neuBerechnen)
// ist nur eine Anzeige-Zahl fürs Detail-Fenster und war nie auf
// echte Spiel-Einheiten abgestimmt. Jeder Faktor hier übersetzt
// die rohe Stärke in eine spürbare, aber nicht übertriebene
// Auswirkung. Rohe Maximalwerte (Gold, Stufe 10) zum Vergleich:
// Waffe(erntebereich) ~10,8 · Rücken(sammelradius) ~74,1 ·
// Brust(ertrag) ~59,8 · Kopf(ertrag) ~45,5 · Füße(tempo) ~45,5
// ============================================

const SKALIERUNG_TEMPO=0.20;         // max ≈ +0,23 Tempo (Gold, Stufe 10)
const SKALIERUNG_ERTRAG=0.18;        // max ≈ +19% Ertrag (Brust+Kopf zusammen Gold)
const SKALIERUNG_SAMMELRADIUS=0.20;  // max ≈ +15px Sammelradius (Gold, Stufe 10)
const SKALIERUNG_ERNTEBEREICH=1.0;   // max ≈ +11px Erntebereich (Gold, Stufe 10)

function aktuelleAusruestungsBuffs(){

    if(typeof window.Ausruestung==="undefined")return null;

    return window.Ausruestung.buffs();

}

function ausruestungsTempoBonus(){

    let buffs=aktuelleAusruestungsBuffs();

    if(!buffs)return 0;

    // buffs.tempo (Rohwert in %) * Skalierung, wirkt auf das Basis-Tempo

    return BASIS_TEMPO*((buffs.tempo*SKALIERUNG_TEMPO)/100);

}

function ausruestungsErtragMultiplikator(){

    let buffs=aktuelleAusruestungsBuffs();

    if(!buffs)return 1;

    return 1+((buffs.ertrag*SKALIERUNG_ERTRAG)/100);

}

function ausruestungsSammelradiusBonus(){

    let buffs=aktuelleAusruestungsBuffs();

    if(!buffs)return 0;

    return buffs.sammelradius*SKALIERUNG_SAMMELRADIUS;

}

function ausruestungsErntebereichBonus(){

    let buffs=aktuelleAusruestungsBuffs();

    if(!buffs)return 0;

    return buffs.erntebereich*SKALIERUNG_ERNTEBEREICH;

}

function ausruestungsXpMultiplikator(){ return 1; }


