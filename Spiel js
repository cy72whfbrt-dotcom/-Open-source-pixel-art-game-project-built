}

// ============================================================
// DIE ZEHN TAGESAUFGABEN
//
// Jeden Tag dieselben zehn. Nach 24 Stunden faengt alles von
// vorn an - Fortschritt, Trophaeen und die fuenf Truhen.
// ============================================================

const TAGESAUFGABEN=[

    {kennung:"beeren",    ziel:300, trophaeen:10, text:"300 Beeren einsammeln"},
    {kennung:"pflanzen",  ziel:40,  trophaeen:10, text:"40 Pflanzen ernten"},
    {kennung:"kisten",    ziel:10,  trophaeen:10, text:"10 Wasserkisten öffnen"},
    {kennung:"petbeeren", ziel:150, trophaeen:10, text:"150 Beeren vom Haustier ernten lassen"},
    {kennung:"auftraege", ziel:5,   trophaeen:15, text:"5 Aufträge abschließen"},
    {kennung:"ertrag",    ziel:3,   trophaeen:15, text:"3 Ertragsstufen verbessern"},
    {kennung:"truhen",    ziel:2,   trophaeen:15, text:"2 Truhen im Shop öffnen"},
    {kennung:"ausbau",    ziel:1,   trophaeen:15, text:"1 Ausrüstungsteil verbessern"},
    {kennung:"knoten",    ziel:1,   trophaeen:20, text:"1 Charakter-Knoten freischalten"},
    {kennung:"level",     ziel:1,   trophaeen:20, text:"1 Level aufsteigen"}

];

// Fuenf Truhen auf dem Balken oben

const TAGESTRUHEN=[

    {marke:20,  muenzen:500,   schluessel:0},
    {marke:40,  muenzen:0,     schluessel:1},
    {marke:60,  muenzen:1500,  schluessel:0},
    {marke:80,  muenzen:0,     schluessel:2},
    {marke:100, muenzen:5000,  schluessel:3}

];

const Q_SPEICHER="inselAbenteuerTagesaufgaben";

// ---- Zustand -----------------------------------------------

let fortschritt={};
let abgeholt={};
let truhenAbgeholt={};
let trophaeen=0;
let tagesStempel="";
let questOffen=false;

function heutigerTag(){

    let d=new Date();

    return d.getFullYear()+"-"+(d.getMonth()+1)+"-"+d.getDate();

}

function restZeitText(){

    let jetzt=new Date();

    let morgen=new Date(
        jetzt.getFullYear(),
        jetzt.getMonth(),
        jetzt.getDate()+1
    );

    let ms=morgen-jetzt;

    let stunden=Math.floor(ms/3600000);

    let minuten=Math.floor((ms%3600000)/60000);

    return stunden+"h "+minuten+"m";

}

function setzeZurueck(){

    fortschritt={};

    abgeholt={};

    truhenAbgeholt={};

    trophaeen=0;

    tagesStempel=heutigerTag();

    TAGESAUFGABEN.forEach(a=>{

        fortschritt[a.kennung]=0;

        abgeholt[a.kennung]=false;

    });

    TAGESTRUHEN.forEach((t,i)=>{

        truhenAbgeholt[i]=false;

    });

}

function pruefeTagwechsel(){

    if(tagesStempel!==heutigerTag()){

        setzeZurueck();

        speichere();

        return true;

    }

    return false;

}

// ---- Speichern ---------------------------------------------

function speichere(){

    try{

        localStorage.setItem(Q_SPEICHER,JSON.stringify({

            tag:tagesStempel,
            fortschritt:fortschritt,
            abgeholt:abgeholt,
            truhenAbgeholt:truhenAbgeholt,
            trophaeen:trophaeen

        }));

    }catch(e){}

}

function lade(){

    setzeZurueck();

    try{

        let roh=localStorage.getItem(Q_SPEICHER);

        if(!roh)return;

        let d=JSON.parse(roh);

        if(d.tag!==heutigerTag())return;

        tagesStempel=d.tag;

        if(d.fortschritt)Object.assign(fortschritt,d.fortschritt);

        if(d.abgeholt)Object.assign(abgeholt,d.abgeholt);

        if(d.truhenAbgeholt)Object.assign(truhenAbgeholt,d.truhenAbgeholt);

        if(typeof d.trophaeen==="number")trophaeen=d.trophaeen;

    }catch(e){}

}

// ---- Zaehlen -----------------------------------------------
//
// Wird aus dem Spiel heraus aufgerufen. Nach aussen sichtbar,
// damit spiel.js drankommt.

// Diese Funktion laeuft bei jeder eingesammelten Beere. Sie darf
// deshalb nichts Teures tun. Frueher wurde hier jedes Mal der
// komplette Tagesstand nach localStorage geschrieben - ein
// synchroner Schreibvorgang mitten im Spiel, der genau das
// Ruckeln verursacht hat.
//
// Jetzt wird nur gemerkt, dass sich etwas geaendert hat.
// Gespeichert und neu gezeichnet wird gebuendelt, hoechstens
// zweimal pro Sekunde.

let musSpeichern=false;

let letzteAuffrischung=0;

function zaehle(kennung,menge){

    if(!fortschritt.hasOwnProperty(kennung))return;

    let eintrag=TAGESAUFGABEN.find(a=>a.kennung===kennung);

    if(!eintrag)return;

    let vorher=fortschritt[kennung];

    fortschritt[kennung]=Math.min(

        eintrag.ziel,
        vorher+(menge||1)

    );

    if(fortschritt[kennung]===vorher)return;

    musSpeichern=true;

    let jetzt=Date.now();

    if(jetzt-letzteAuffrischung<500)return;

    letzteAuffrischung=jetzt;

    sichereJetzt();

}

function sichereJetzt(){

    if(!musSpeichern)return;

    musSpeichern=false;

    speichere();

    if(questOffen)zeichne();

    aktualisiereHinweis();

}

window.questFortschritt=zaehle;

// ---- Belohnungen -------------------------------------------

function gibMuenzen(betrag){

    if(typeof coins!=="number")return;

    coins+=betrag;

    if(typeof aktualisiereAnzeige==="function")aktualisiereAnzeige();

}

function gibSchluessel(anzahl){

    if(typeof window.Ausruestung==="undefined")return;

    if(typeof window.Ausruestung.gibSchluessel!=="function")return;

    window.Ausruestung.gibSchluessel(anzahl);

}

function holeAufgabe(kennung){

    let eintrag=TAGESAUFGABEN.find(a=>a.kennung===kennung);

    if(!eintrag)return;

    if(abgeholt[kennung])return;

    if(fortschritt[kennung]<eintrag.ziel)return;

    abgeholt[kennung]=true;

    trophaeen+=eintrag.trophaeen;

    speichere();

    zeichne();

    aktualisiereHinweis();

}

function holeTruhe(index){

    let truhe=TAGESTRUHEN[index];

    if(!truhe)return;

    if(truhenAbgeholt[index])return;

    if(trophaeen<truhe.marke)return;

    truhenAbgeholt[index]=true;

    if(truhe.muenzen>0)gibMuenzen(truhe.muenzen);

    if(truhe.schluessel>0)gibSchluessel(truhe.schluessel);

    speichere();

    zeichne();

    aktualisiereHinweis();

}

// Gibt es gerade etwas abzuholen?

function etwasOffen(){

    let da=false;

    TAGESAUFGABEN.forEach(a=>{

        if(!abgeholt[a.kennung] && fortschritt[a.kennung]>=a.ziel)da=true;

    });

    TAGESTRUHEN.forEach((t,i)=>{

        if(!truhenAbgeholt[i] && trophaeen>=t.marke)da=true;

    });

    return da;

}

function aktualisiereHinweis(){

    let knopf=document.getElementById("questKnopf");

    if(!knopf)return;

    let punkt=knopf.querySelector(".questHinweis");

    if(etwasOffen()){

        if(!punkt){

            punkt=document.createElement("div");

            punkt.className="questHinweis";

            punkt.textContent="!";

            knopf.appendChild(punkt);

        }

    }else if(punkt){

        punkt.remove();

    }

}

