// Kartenstufe wächst schrittweise (5,6,7,...) über die Lager-Aufgabe

// Karten-Größe basierend auf Level
// L1-9: 3x3
// L10-24: 4x4
// L25-50: 5x5

// Nur ungerade Kantenlaengen. Eine gerade Zahl hat kein
// Mittelfeld - das Lager saesse dann ein halbes Feld daneben.

function karteSizeForLevel(lvl){

    if(lvl<10)return 3;   // L1-9:   3x3, 9 Felder

    if(lvl<40)return 5;   // L10-39: 5x5, 25 Felder

    return 7;             // L40+:   7x7, 49 Felder

}

// Wie viele Pflanzen gleichzeitig stehen. Waechst mit der Flaeche,
// sonst wird die groessere Insel nur leerer statt ergiebiger.

function pflanzenZiel(){

    if(kartenStufe<=3)return 3;

    if(kartenStufe<=5)return 6;

    return 10;

}

