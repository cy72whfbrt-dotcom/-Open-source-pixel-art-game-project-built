const PET_WERTE={

    grau :{radius:1.0, sekunden:6.0, bonus:0.00},
    gruen:{radius:1.2, sekunden:5.0, bonus:0.05},
    blau :{radius:1.5, sekunden:4.0, bonus:0.10},
    gold :{radius:1.8, sekunden:3.0, bonus:0.18}

};

// Pro Stufe nur ein Zehntel Feld mehr. Die Insel ist im Endausbau
// 5x5 Felder gross - ein Umkreis von 3 Feldern wuerde bereits alles
// abdecken und jede weitere Stufe waere wertlos.

function petRadiusFelder(pet){

    return Math.round(
        (PET_WERTE[pet.seltenheit].radius+(pet.stufe-1)*0.1)*10
    )/10;

}

function petIntervall(pet){

    // Pro Stufe 7% schneller, aber nie unter einer halben Sekunde

    let s=PET_WERTE[pet.seltenheit].sekunden*Math.pow(0.95,pet.stufe-1);

    return Math.max(500,Math.round(s*1000));

}

function petErtragBonus(pet){

    return PET_WERTE[pet.seltenheit].bonus;

}

function petUpgradeKosten(pet){

    return Math.round(250*Math.pow(1.55,pet.stufe)*SELTENHEIT[pet.seltenheit].faktor);

}

// Id des angelegten Haustiers, null wenn keins aktiv ist

let angelegtesPetId=null;

function angelegtesPet(){

    if(angelegtesPetId===null)return null;

    return meinePets.find(p=>p.id===angelegtesPetId)||null;

}

