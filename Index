<!-- ==================================================
     SCRIPTE
     ================================================== -->
<script>
// Faengt auch Fehler ab, die beim Einlesen von spiel.js entstehen.
// Muss VOR den Skripten stehen, sonst ist es zu spaet.
(function(){
    function zeige(text){
        var box=document.getElementById("startFehler");
        if(!box){
            box=document.createElement("div");
            box.id="startFehler";
            box.style.cssText=
            "position:fixed;left:0;right:0;top:0;z-index:99999;"+
            "background:#b00020;color:#fff;font:12px/1.45 monospace;"+
            "padding:10px;white-space:pre-wrap;max-height:60vh;overflow:auto;";
            (document.body||document.documentElement).appendChild(box);
        }
        box.textContent+=text+String.fromCharCode(10,10);
    }
    window.addEventListener("error",function(e){
        var u=String.fromCharCode(10);

        // Fehlgeschlagene Bilder und andere Dateien haben keine
        // Meldung - die getrennt und verstaendlich anzeigen
        if(!e.message && e.target && e.target.src){
            zeige("DATEI FEHLT: "+e.target.src.split("/").slice(-2).join("/"));
            return;
        }

        // Sonstige Ereignisse ohne Meldung ignorieren
        if(!e.message)return;

        zeige("FEHLER: "+e.message+
              u+"Datei: "+((e.filename||"?").split("/").pop())+
              u+"Zeile: "+e.lineno+":"+e.colno);
    },true);

    // Nach dem Laden pruefen, ob spiel.js wirklich durchgelaufen ist
    window.addEventListener("load",function(){
        setTimeout(function(){
            if(typeof aktualisiereAnzeige!=="function"){
                zeige("spiel.js wurde NICHT ausgefuehrt."+
                      String.fromCharCode(10)+
                      "Datei fehlt, ist unvollstaendig oder hat einen Syntaxfehler.");
            }
        },500);
    });
})();
</script>

