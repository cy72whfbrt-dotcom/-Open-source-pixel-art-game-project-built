// Schneller Zugriff auf die Pflanzen-Bilddatei

const PFLANZEN_BILD={};

PFLANZEN.forEach(p=>{ PFLANZEN_BILD[p.typ]=p.bild; });

// Welche Sorten auf einem Level bereits wachsen

function sortenAbLevel(lvl){

    return PFLANZEN.filter(p=>lvl>=p.abLevel).map(p=>p.typ);

}

function sortenName(typ){

    let p=PFLANZEN.find(x=>x.typ===typ);

    return p?p.name:typ;

}

// ============================================================
// AUFGABEN
//
// Pro Level zwei normale Aufgaben plus die Lager-Aufgabe.
// Die Ziele wachsen mit dem Level, die Sorten stammen immer
// aus dem, was gerade freigeschaltet ist - die jeweils neueste
// Sorte kommt dabei bevorzugt dran.
// ============================================================

const aufgabenListe={};

let globalId=1000;

for(let lvl=1;lvl<=MAX_LEVEL;lvl++){

    let offen=sortenAbLevel(lvl);

    let neueste=offen[offen.length-1];

    // Zweite Sorte rotiert durch die aelteren, damit sich nichts
    // zu schnell wiederholt

    let zweite=offen[(lvl*3)%offen.length];

    if(zweite===neueste && offen.length>1){

        zweite=offen[(lvl*3+1)%offen.length];

    }

    let grundZiel=12+Math.round(lvl*1.6);

    let belohnung=20+lvl*3;

    aufgabenListe[lvl]=[];

    // Erste Aufgabe: immer die neueste Sorte

    aufgabenListe[lvl].push({

        id:globalId++,
        name:sortenName(neueste)+" ernten ("+grundZiel+")",
        anforderungen:[{typ:neueste,ziel:grundZiel,fortschritt:0}],
        belohnung:belohnung,
        xp:10+lvl,
        isLagerUpgrade:false

    });

    // Zweite Aufgabe: jedes dritte Level eine Doppelaufgabe

    if(lvl%3===0 && offen.length>1){

        let a=Math.round(grundZiel*0.6);

        let b=Math.round(grundZiel*0.5);

        aufgabenListe[lvl].push({

            id:globalId++,
            name:sortenName(zweite)+" und "+sortenName(neueste)+
                 " sammeln ("+a+"+"+b+")",
            anforderungen:[
                {typ:zweite,ziel:a,fortschritt:0},
                {typ:neueste,ziel:b,fortschritt:0}
            ],
            belohnung:Math.round(belohnung*1.3),
            xp:12+lvl,
            isLagerUpgrade:false

        });

    }else{

        aufgabenListe[lvl].push({

            id:globalId++,
            name:sortenName(zweite)+" ernten ("+Math.round(grundZiel*1.1)+")",
            anforderungen:[{typ:zweite,ziel:Math.round(grundZiel*1.1),fortschritt:0}],
            belohnung:belohnung,
            xp:10+lvl,
            isLagerUpgrade:false

        });

    }

    // Lager-Aufgabe

    aufgabenListe[lvl].push({

        id:globalId++,
        name:"Lager Level "+(lvl+1),
        anforderungen:[{typ:"lager",ziel:lvl+1,fortschritt:0}],
        belohnung:50+lvl*5,
        xp:30+lvl*3,
        isLagerUpgrade:true

    });

}
